{
  "name": "irsim",
  "version": "0.1.0",
  "description": "IRsim — open-source interventional radiology navigation trainer (web-first). Guidewire/sheath navigation through vascular anatomy, shown in both 3D and a stylized 2D fluoroscopy view.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Remedy92/Irsim.git"
  },
  "bugs": {
    "url": "https://github.com/Remedy92/Irsim/issues"
  },
  "homepage": "https://github.com/Remedy92/Irsim#readme",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "browser:physics": "node scripts/browser-physics-smoke.mjs",
    "browser:dicom": "node scripts/browser-dicom-smoke.mjs",
    "browser:dicom:j2k": "node scripts/browser-dicom-smoke.mjs --compressed jpeg2000-lossless",
    "fixture:dicom:fetch": "node scripts/fetch-real-dicom-fixture.mjs",
    "fixture:dicom:j2k:fetch": "node scripts/fetch-jpeg2000-ct-fixtures.mjs",
    "fixture:dicom:j2k:verify": "node node_modules/vitest/vitest.mjs run --config scripts/vitest.jpeg2000-fixture.config.mjs --reporter=verbose",
    "browser:dicom:real": "node scripts/browser-dicom-smoke.mjs --fixture-manifest fixtures/real-dicom/tcia-pancreas-ct.json --fixture-dir output/fixtures/tcia-pancreas-ct",
    "fixture:cta:fetch": "node scripts/fetch-aortaseg-cta-source.mjs",
    "fixture:cta:derive": "node scripts/derive-aortaseg-dicom.mjs",
    "fixture:cta:j2k:derive": "node scripts/derive-aortaseg-dicom.mjs --compressed jpeg2000-lossless",
    "fixture:cta:j2k:verify": "node --max-old-space-size=2048 node_modules/vitest/vitest.mjs run --config scripts/vitest.compressed-study.config.mjs --reporter=verbose",
    "fixture:cta:verify": "node --max-old-space-size=2048 node_modules/vitest/vitest.mjs run --config scripts/vitest.fixture.config.mjs --reporter=verbose",
    "fixture:cta:budget": "node --expose-gc --max-old-space-size=2048 node_modules/vitest/vitest.mjs run --config scripts/vitest.study-budget.config.mjs --reporter=verbose",
    "browser:dicom:cta": "node scripts/browser-dicom-smoke.mjs --fixture-manifest fixtures/real-dicom/aortaseg60-young05-derived.json --fixture-dir output/fixtures/aortaseg60-young05-dicom",
    "browser:dicom:cta:j2k:benchmark": "node scripts/browser-dicom-smoke.mjs --study-benchmark --fixture-manifest fixtures/real-dicom/aortaseg60-young05-derived.json --fixture-report output/fixtures/aortaseg60-young05-dicom-j2k/DERIVATION.json --fixture-dir output/fixtures/aortaseg60-young05-dicom-j2k --out output/browser-cta-j2k-benchmark",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "1.3.0",
    "@react-three/fiber": "^9.0.4",
    "dicom-parser": "1.8.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^4.1.8"
  }
}
